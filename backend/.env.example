# Copia este archivo a ".env" (en la misma carpeta) y ajusta lo que necesites.
# Todas las variables llevan el prefijo PINTAPP_. Las que no definas usan su valor por defecto.
# (Los comentarios van en su propia línea, no al lado del valor.)

# development | production (en production se ocultan /docs y /openapi.json)
PINTAPP_ENVIRONMENT=development
PINTAPP_HOST=127.0.0.1
PINTAPP_PORT=8000
# true = reinicio automático al editar código (solo desarrollo)
PINTAPP_RELOAD=false
PINTAPP_LOG_LEVEL=INFO
# Solo si un cliente web llama a la API; la app de escritorio no lo necesita.
# PINTAPP_CORS_ORIGINS=["http://localhost:3000"]

# Base de datos (opcional por ahora; el prototipo usa inventario simulado):
# PINTAPP_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/pintapp
# PINTAPP_DATABASE_URL=mariadb+asyncmy://usuario:clave@localhost:3306/pintapp

# Simulación de la IA (útil para que el frontend pruebe estados de fallo y tiempo agotado).
PINTAPP_SIM_MIN_SECONDS=3
PINTAPP_SIM_MAX_SECONDS=6
# 0 a 1; por ejemplo 0.3 = 30 % de las generaciones fallan.
PINTAPP_SIM_FAILURE_RATE=0
PINTAPP_GENERATION_TIMEOUT_SECONDS=60
